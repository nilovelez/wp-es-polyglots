#: blocks/data-request/block.json
msgctxt "block keyword"
msgid "gdpr"
msgstr "rgpd"

#. Description of the plugin
#: gdpr-compliance-cookie-consent.php
msgid "Cookie consent banner and GDPR tools (consent checkboxes, data access and erasure requests) that help you manage visitor consent."
msgstr "Banner de consentimiento de cookies y herramientas del RGPD (casillas de verificación de consentimiento, solicitudes de acceso y supresión de datos) que te ayudan a gestionar el consentimiento de los visitantes."

#: includes/STM_PluginOptions.php:233
msgid "Our plugin currently supports <b>Contact Form 7</b>, <b>Gravity Forms</b>, <b>WooCommerce</b>, <b>WordPress Comments</b>, <b>MailChimp Wp</b>, <b>BuddyPress</b>. Integrated plugins options will be displayed automatically after installing and activating supported plugins. You can use HTML tags and <span>%privacy_policy%</span> shortcode link in the checkbox labels (HTML tags are NOT allowed for Gravity Forms due to plugin limitations)."
msgstr "Nuestro plugin es compatible actualmente con <b>Contact Form 7</b>, <b>Gravity Forms</b>, <b>WooCommerce</b>, <b>WordPress Comments</b>, <b>MailChimp Wp</b>, <b>BuddyPress</b>. Las opciones de los plugins integrados se mostrarán automáticamente tras instalar y activar los plugins compatibles. Puedes usar etiquetas HTML y el enlace del shortcode <span>%privacy_policy%</span> en las etiquetas de las casillas de verificación (las etiquetas HTML NO se permiten en Gravity Forms por limitaciones del plugin)."

