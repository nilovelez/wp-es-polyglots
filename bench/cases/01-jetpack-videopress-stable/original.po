#: jetpack_vendor/automattic/jetpack-videopress/build/trim-cut-modal.js:1
msgid "Your unsaved edits will be replaced with the latest saved version."
msgstr "Tus ediciones no guardadas se reemplazarán por la última versión guardada."

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:146
