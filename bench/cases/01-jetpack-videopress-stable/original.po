msgstr "¿Recargar las últimas ediciones?"

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:145
#: jetpack_vendor/automattic/jetpack-videopress/build/trim-cut-modal.js:1
msgid "Restore original"
msgstr "Restaurar original"

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:144
#: jetpack_vendor/automattic/jetpack-videopress/build/trim-cut-modal.js:1
msgid "All saved and unsaved video edits will be removed. Viewers will see the original video again."
msgstr "Se eliminarán todas las ediciones del vídeo, guardadas y no guardadas. Los espectadores volverán a ver el vídeo original."

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:143
msgid "Restore original?"
msgstr "¿Restaurar original?"

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:142
msgid "Your unsaved edits will be discarded and the editor will return to the last saved version."
msgstr "Tus ediciones no guardadas se descartarán y el editor volverá a la última versión guardada."

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:140
#: jetpack_vendor/automattic/jetpack-videopress/build/trim-cut-modal.js:1
msgid "Update video"
msgstr "Actualizar vídeo"

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:138
msgid "Update video?"
msgstr "¿Actualizar el vídeo?"

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:137
msgid "You have unsaved edits. Leave the editor and discard them?"
msgstr "Tienes modificaciones sin guardar. ¿Quieres salir del editor y descartarlos?"

#: jetpack_vendor/automattic/jetpack-videopress/build/routes/video-editor/content.js:139
#: jetpack_vendor/automattic/jetpack-videopress/build/trim-cut-modal.js:1
msgid "Viewers will see the edited video. Your original is kept and can be restored. Existing chapters may need to be adjusted after the video finishes processing."
msgstr "Los espectadores verán el vídeo editado. Tu original se mantiene y se puede restaurar. Los capítulos existentes pueden necesitar ser ajustados después de que el vídeo termine de procesarse."

