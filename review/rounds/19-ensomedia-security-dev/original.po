msgstr "El parche virtual %1$s bloqueó una solicitud que coincide con %4$s en %2$s %3$s."

#. translators: 1: virtual patch id, 2: plugin folder name, 3: plugin version,
#. 4: advisory id.
#: includes/protect/class-vpatch-switch.php:603
