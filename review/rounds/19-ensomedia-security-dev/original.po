msgstr "El listado de archivos de estos plugins no terminó (demasiados archivos o poco tiempo), así que pueden haberse pasado por alto archivos PHP añadidos a ellos: %s. El próximo análisis lo intenta de nuevo."

#. translators: %s: number of files.
#: includes/checks/class-plugin-checksums.php:277
msgid "WordPress.org did not answer for some plugins, so %s file could not be verified this time."
msgid_plural "WordPress.org did not answer for some plugins, so %s files could not be verified this time."
msgstr[0] "WordPress.org no respondió para algunos plugins, así que esta vez no se pudo verificar %s archivo."
msgstr[1] "WordPress.org no respondió para algunos plugins, así que esta vez no se pudieron verificar %s archivos."

#. translators: %s: number of files.
#: includes/checks/class-plugin-checksums.php:283
#: includes/checks/class-theme-checksums.php:276
