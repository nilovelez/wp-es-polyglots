msgstr "%s ha cambiado desde el último análisis. Los archivos de configuración del servidor deciden cómo trata el servidor cada solicitud de su carpeta y de las carpetas inferiores."

#: includes/checks/class-file-changes.php:1796
msgid "A new server configuration file appeared"
msgstr "Ha aparecido un archivo de configuración del servidor nuevo"

#: includes/checks/class-file-changes.php:1796
