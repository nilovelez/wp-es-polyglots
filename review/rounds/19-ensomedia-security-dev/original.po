msgid_plural "WordPress.org did not answer for some themes, so %s files could not be verified this time."
msgstr[0] "WordPress.org no respondió para algunos temas, así que esta vez no se pudo verificar %s archivo."
msgstr[1] "WordPress.org no respondió para algunos temas, así que esta vez no se pudieron verificar %s archivos."

#: includes/checks/class-theme-checksums.php:633
msgid "Most files of a theme differ from its WordPress.org release"
msgstr "La mayoría de los archivos de un tema difieren de su versión publicada en WordPress.org"

#: includes/checks/class-theme-checksums.php:762
msgid "A theme has a version WordPress.org never released"
msgstr "Un tema tiene una versión que WordPress.org nunca publicó"

#. translators: %s: theme name.
#: includes/checks/class-theme-checksums.php:772
