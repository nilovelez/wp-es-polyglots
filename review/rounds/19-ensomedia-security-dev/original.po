msgstr "Para confirmar que eres tú, se ha enviado un código de 6 dígitos a %s. Introdúcelo para continuar. Es válido durante 15 minutos."

#: includes/class-two-factor.php:1642
msgid "Code from the email"
msgstr "Código del correo"

#: includes/class-two-factor.php:1658
msgid "Send a new code"
msgstr "Enviar un código nuevo"

