msgid_plural "%d virtual patches now block the matching requests."
msgstr[0] "%d parche virtual ahora bloquea las solicitudes que coinciden."
msgstr[1] "%d parches virtuales ahora bloquean las solicitudes que coinciden."

#. translators: 1: virtual patch id, 2: plugin folder name.
#: includes/protect/class-vpatch-switch.php:595
msgid "Virtual patch %1$s for %2$s could not check a request in full (a value too long or a pattern that failed). The patch is in record-only mode, so the request was let through."
msgstr "El parche virtual %1$s para %2$s no pudo comprobar una solicitud completa (un valor demasiado largo o un patrón que falló). El parche está en modo solo registro, así que la solicitud pasó."

#. translators: 1: virtual patch id, 2: plugin folder name, 3: plugin version,
