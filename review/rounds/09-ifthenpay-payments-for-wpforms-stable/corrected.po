#: src/Templates/ExampleFormTemplate.php:33
msgid "A ready-made example form showing the ifthenpay | Payment Gateway field alongside common field types."
msgstr "Un formulario de ejemplo ya preparado que muestra el campo ifthenpay | Pasarela de pago junto con tipos de campo habituales."

#: src/Templates/ComplexFormTemplate.php:35
msgid "A 3-step example checkout showing the ifthenpay | Payment Gateway field alongside page breaks, a payment dropdown, and a spam-check field."
msgstr "Un ejemplo de pago en 3 pasos que muestra el campo ifthenpay | Pasarela de pago junto con saltos de página, un desplegable de pago y un campo de verificación anti-spam."

#: src/Plugin.php:238
msgid "Complete your payment in the tab that just opened — we'll update this page automatically."
msgstr "Completa el pago en la pestaña que se acaba de abrir — actualizaremos esta página automáticamente."

#: src/Api/WPForms/Payments.php:976
msgid "Show entry preview after confirmation message"
msgstr "Mostrar vista previa del registro después del mensaje de confirmación"

#: src/Api/WPForms/Payments.php:838
msgid "Customize what customers see in the ifthenpay payment popup for each outcome, pre-filled with the default text below. This is separate from the WPForms Confirmations tab, which does not apply to this popup."
msgstr "Personaliza lo que ven los clientes en la ventana emergente de pago de ifthenpay para cada resultado, rellenado de antemano con el texto por defecto que aparece abajo. Es independiente de la pestaña Confirmaciones de WPForms, que no se aplica a esta ventana."

#: src/Api/WPForms/Payments.php:805 src/Plugin.php:248
msgid "We're waiting for your payment to be confirmed. You don't need to do anything else — this will update automatically once it's complete."
msgstr "Estamos esperando la confirmación de tu pago. No tienes que hacer nada más — se actualizará automáticamente cuando se complete."

#: src/Api/WPForms/Payments.php:657 src/Builder/Payments.php:648
msgid "Set as default payment method"
msgstr "Establecer como método de pago por defecto"

#: src/Api/WPForms/Payments.php:617 src/Builder/Payments.php:608
msgid "Default"
msgstr "Por defecto"

#: src/Plugin.php:242
msgid "Unable to open payment"
msgstr "No se ha podido abrir el pago"

#: src/Api/WPForms/Payments.php:1190 src/Builder/Payments.php:911
msgid "Choose the gateway key that should be used by this form."
msgstr "Elige la clave de pasarela que debe usar este formulario."

#: src/Api/WPForms/Payments.php:1181 src/Builder/Payments.php:902
msgid "Gateway key"
msgstr "Clave de pasarela"

#: src/Api/WPForms/Payments.php:319 src/Builder/Payments.php:313
msgid "Missing gateway, method, or Backoffice Key."
msgstr "Falta la pasarela, el método o la clave de Backoffice."

#: src/Api/WPForms/Payments.php:311 src/Builder/Payments.php:305
msgid "Connect a valid Backoffice Key in WPForms Settings > Payments before activating payment methods."
msgstr "Conecta una clave de Backoffice válida en Ajustes de WPForms > Pagos antes de activar métodos de pago."

#: src/Api/WPForms/Payments.php:262 src/Builder/Payments.php:256
msgid "Select a valid ifthenpay gateway key."
msgstr "Selecciona una clave de pasarela de ifthenpay válida."

#: src/Api/WPForms/Field.php:643 src/Builder/Field.php:584
msgid "This field is disabled because no gateway key is selected in the Payments tab."
msgstr "Este campo está desactivado porque no hay ninguna clave de pasarela seleccionada en la pestaña Pagos."

#: src/Api/WPForms/Field.php:490 src/Builder/Field.php:492
msgid "Connect your ifthenpay Backoffice Key in WPForms Settings » Payments » ifthenpay to use this field."
msgstr "Conecta tu clave de Backoffice de ifthenpay en Ajustes de WPForms » Pagos » ifthenpay para usar este campo."

#: src/Api/WPForms/Field.php:181 src/Builder/Field.php:183
msgid "<p>{name} requires a gateway key to be selected.</p><p>To proceed, please go to <strong>Payments Â» {name}</strong> and choose a <strong>Gateway key</strong>.</p>"
msgstr "<p>{name} requiere que se seleccione una clave de pasarela.</p><p>Para continuar, ve a <strong>Pagos » {name}</strong> y elige una <strong>clave de pasarela</strong>.</p>"

#: src/Api/WPForms/Field.php:171 src/Builder/Field.php:173
msgid "<p>ifthenpay account connection is required when using the ifthenpay field.</p><p>To proceed, please go to <strong>WPForms Settings » Payments » ifthenpay</strong> and connect your account.</p>"
msgstr "<p>Es obligatorio conectar la cuenta de ifthenpay para usar el campo de ifthenpay.</p><p>Para continuar, ve a <strong>Ajustes de WPForms » Pagos » ifthenpay</strong> y conecta tu cuenta.</p>"

#: src/Admin/Settings.php:240
msgid "Enter your Backoffice Key and click Connect to load your WPForms gateways."
msgstr "Introduce tu clave de Backoffice y haz clic en Conectar para cargar tus pasarelas de WPForms."

#: src/Admin/Settings.php:234
msgid "Connected. Gateway keys and methods are configured inside the form builder."
msgstr "Conectado. Las claves de pasarela y los métodos se configuran dentro del constructor de formularios."

#: src/Admin/Settings.php:225
msgid "Connect your Backoffice Key here. Per-form gateway selection and method settings are configured inside the form builder."
msgstr "Conecta aquí tu clave de Backoffice. La selección de pasarela y los ajustes de métodos de cada formulario se configuran dentro del constructor de formularios."

#: src/Admin/Settings.php:224 src/Plugin.php:205
msgid "ifthenpay | Payment Gateway"
msgstr "ifthenpay | Pasarela de pago"

#: src/Admin/Settings.php:181
