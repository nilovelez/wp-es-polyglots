msgstr "Ajustes por defecto"

#. translators: %d: generation job identifier.
#: assets/admin.js:298
msgid "Copied from the brief of job #%d. Change what you want to improve, then create a new draft."
msgstr "Copiado de las instrucciones de la tarea #%d. Ajusta lo que quieras mejorar y crea otro borrador."

#: assets/admin.js:298
msgid "Its writer profile no longer exists, so Default settings is selected."
msgstr "Su perfil de autor ya no existe; se seleccionaron los ajustes por defecto."

#. translators: %d: generation job ID.
#: assets/admin.js:422
msgid "Generation job #%d"
msgstr "Tarea de generación #%d"

#: assets/admin.js:435
