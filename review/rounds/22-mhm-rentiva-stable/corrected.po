#: src/Admin/Utilities/Database/DatabaseCleanupPage.php:245
msgid "Cleanup cancelled: this site's table prefix is too long for the cleanup to name a backup table. Nothing was deleted."
msgstr "Limpieza cancelada: el prefijo de las tablas de este sitio es demasiado largo para asignar un nombre a la tabla de copia de seguridad. No se ha borrado nada."

#. translators: 1: current table-prefix length in characters. 2: maximum
#. supported length in characters.
#: src/Admin/Core/Utilities/DatabaseCleaner.php:1215
msgid "This site's table prefix (%1$d characters) is too long for the invalid-meta cleanup to name a backup table within MySQL's 64-character identifier limit (maximum supported: %2$d characters). The cleanup was not run."
msgstr "El prefijo de las tablas de este sitio (%1$d caracteres) es demasiado largo para que la limpieza de metadatos no válidos pueda asignar un nombre a una tabla de copia de seguridad dentro del límite de 64 caracteres de MySQL (máximo compatible: %2$d caracteres). No se ha ejecutado la limpieza."

#: src/Admin/Core/Utilities/DatabaseCleaner.php:1032
msgid "Cleanup cancelled: the backup table could not be created or filled. Nothing was deleted."
msgstr "Limpieza cancelada: no se ha podido crear ni rellenar la tabla de copia de seguridad. No se ha borrado nada."

