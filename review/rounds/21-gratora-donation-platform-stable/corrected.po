#: src/Settings/SettingsService.php:379
msgid "Hi {donor_first_name},\n\nYour next recurring donation of {amount} to {campaign_title} has been skipped. Nothing will be charged this time, and the donation continues on {next_payment_at}.\n\nYou can manage it any time here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu siguiente donación recurrente de {amount} a {campaign_title} se ha omitido. Esta vez no se cobrará nada, y la donación continuará el {next_payment_at}.\n\nPuedes gestionarla cuando quieras aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:378
msgid "Your next donation has been skipped"
msgstr "Tu siguiente donación se ha omitido"

#: src/Settings/SettingsService.php:374
msgid "Hi {donor_first_name},\n\nYour recurring donation of {amount} to {campaign_title} has restarted. Your next payment is due on {next_payment_at}.\n\nYou can manage it any time here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu donación recurrente de {amount} a {campaign_title} se ha reanudado. Tu siguiente pago está previsto para el {next_payment_at}.\n\nPuedes gestionarla cuando quieras aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

#: src/Settings/SettingsService.php:359
msgid "Hi {donor_first_name},\n\nYour recurring donation to {campaign_title} has been changed from {old_amount} to {amount}, starting with your next payment.\n\nIf that is not what you expected, you can change it back or stop the donation here:\n{portal_url}\n\nThanks,\n{organisation_name}"
msgstr "Hola, {donor_first_name}:\n\nTu donación recurrente a {campaign_title} ha pasado de {old_amount} a {amount}, a partir de tu siguiente pago.\n\nSi no es lo que esperabas, puedes volver al importe anterior o detener la donación aquí:\n{portal_url}\n\nGracias,\n{organisation_name}"

