#. Description of the plugin
#: webandroll-orderflow.php
msgid "Custom WooCommerce order statuses and workflow automation."
msgstr "Estados de pedido personalizados y automatización de flujos de trabajo para WooCommerce."

#: src/Admin/Handlers/AutomationActionsHandler.php:121
msgid "Sorry, you are not allowed to change this automation."
msgstr "Lo siento, no tienes permisos para modificar esta automatización."

#: src/Admin/Handlers/AutomationActionsHandler.php:161
msgid "Sorry, you are not allowed to delete this automation."
msgstr "Lo siento, no tienes permisos para borrar esta automatización."

#: src/Admin/Handlers/AutomationFormHandler.php:140
msgid "Sorry, you are not allowed to save this automation."
msgstr "Lo siento, no tienes permisos para guardar esta automatización."

#: src/Admin/Handlers/ReorderController.php:73
msgid "Sorry, you are not allowed to reorder statuses."
msgstr "Lo siento, no tienes permisos para reordenar los estados."

#: src/Admin/Handlers/SettingsFormHandler.php:63
msgid "Sorry, you are not allowed to save these settings."
msgstr "Lo siento, no tienes permisos para guardar estos ajustes."

#: src/Admin/Handlers/StatusDeleteHandler.php:103
msgid "Sorry, you are not allowed to delete this status."
msgstr "Lo siento, no tienes permisos para borrar este estado."

#: src/Admin/Handlers/StatusFormHandler.php:112
msgid "Sorry, you are not allowed to save this status."
msgstr "Lo siento, no tienes permisos para guardar este estado."

#: src/Admin/ListTables/AutomationListTable.php:248
msgid "Delete this automation? Its run history is kept."
msgstr "¿Borrar esta automatización? Se conserva su historial de ejecuciones."

#: src/Admin/ListTables/AutomationListTable.php:252
#: src/Admin/ListTables/StatusListTable.php:184
msgid "Delete"
msgstr "Borrar"

#. translators: %d: automation id.
#: src/Admin/ListTables/RunListTable.php:253 src/Admin/Pages/RunsPage.php:206
msgid "Deleted automation #%d"
msgstr "Automatización borrada #%d"

#: src/Admin/ListTables/StatusListTable.php:335
msgid "Deletion blocked. See WooCommerce > Status > Logs."
msgstr "Borrado bloqueado. Consulta WooCommerce > Estado > Registros."

#. translators: %s: status orders are moved to.
#: src/Admin/ListTables/StatusListTable.php:343
msgid "Deleting: orders are being moved to %s."
msgstr "Borrando: los pedidos se están moviendo a %s."

#: src/Admin/Menu.php:123
msgid "Sorry, you are not allowed to access Webandroll OrderFlow."
msgstr "Lo siento, no tienes permisos para acceder a Webandroll OrderFlow."

#: src/Admin/Onboarding.php:116
msgid "Sorry, you are not allowed to create the example workflow."
msgstr "Lo siento, no tienes permisos para crear el flujo de ejemplo."

#: src/Admin/Pages/AutomationEditPage.php:216
msgid "This action is incomplete. Fill in the required fields and check the email addresses."
msgstr "Esta acción está incompleta. Rellena los campos obligatorios y comprueba las direcciones de correo electrónico."

#: src/Admin/Pages/AutomationsPage.php:170
msgid "Automation deleted."
msgstr "Automatización borrada."

#: src/Admin/Pages/HelpPage.php:89
msgid "Orders keep their custom status. Delete each status on the Statuses tab so orders move to a native status before you delete the plugin."
msgstr "Los pedidos conservan su estado personalizado. Borra cada estado en la pestaña Estados para moverlos a un estado nativo antes de borrar el plugin."

#: src/Admin/Pages/RunsPage.php:161
msgid "This log shows what each automation did, or why it did not run. Entries older than the retention period set in Settings are deleted automatically."
msgstr "Este registro muestra lo que hizo cada automatización, o por qué no se ejecutó. Las entradas más antiguas que el periodo de conservación establecido en Ajustes se borran automáticamente."

#: src/Admin/Pages/SettingsPage.php:123
msgid "Run history entries older than this number of days are deleted automatically."
msgstr "Las ejecuciones más antiguas que este número de días se borran automáticamente."

#: src/Admin/Pages/SettingsPage.php:134
msgid "Delete data on uninstall"
msgstr "Borrar datos al desinstalar"

#: src/Admin/Pages/SettingsPage.php:141
msgid "Delete custom statuses, automations, history and settings when the plugin is deleted."
msgstr "Borrar los estados personalizados, las automatizaciones, el historial y los ajustes al borrar el plugin."

#: src/Admin/Pages/SettingsPage.php:143
msgid "Orders that use a custom status keep it after deletion and may disappear from some WooCommerce views. Delete each custom status first (Statuses tab) to move its orders to another status."
msgstr "Los pedidos que usan un estado personalizado lo conservan tras el borrado y pueden desaparecer de algunas vistas de WooCommerce. Borra primero cada estado personalizado (pestaña Estados) para mover sus pedidos a otro estado."

#: src/Admin/Pages/StatusDeletePage.php:76
msgid "This status is already being deleted."
msgstr "Este estado ya se está borrando."

#: src/Admin/Pages/StatusDeletePage.php:93
#: src/Admin/Pages/StatusDeletePage.php:122
msgid "Delete status"
msgstr "Borrar estado"

#: src/Admin/Pages/StatusDeletePage.php:129
msgid "Delete status and move orders"
msgstr "Borrar estado y mover pedidos"

#. translators: %s: status label.
#: src/Admin/Pages/StatusDeletePage.php:144
msgid "Delete status: %s"
msgstr "Borrar estado: %s"

#: src/Admin/Pages/StatusDeletePage.php:200
msgid "Orders are moved in the background, in batches of 50. Customers do not receive any email. WooCommerce stock rules apply to the new status."
msgstr "Los pedidos se mueven en segundo plano, en lotes de 50. Los clientes no reciben ningún correo electrónico. Las reglas de inventario de WooCommerce se aplican al nuevo estado."

#: src/Admin/Pages/StatusEditPage.php:212
msgid "Stock, coupons, and downloads follow the paid-status rules."
msgstr "El inventario, los cupones y las descargas siguen las reglas de los estados pagados."

#: src/Admin/Pages/StatusEditPage.php:366
msgid "Used if this status is deleted or the plugin is removed."
msgstr "Se usa si se borra este estado o se desinstala el plugin."

#: src/Admin/Pages/StatusEditPage.php:402
msgid "Notifications"
msgstr "Avisos"

#: src/Admin/Pages/StatusEditPage.php:547
msgid "Comma-separated email addresses. The recipient set in WooCommerce > Settings > Emails is always included."
msgstr "Direcciones de correo electrónico separadas por comas. El destinatario establecido en WooCommerce > Ajustes > Correos electrónicos siempre está incluido."

#. translators: %s: link to the WooCommerce email settings.
#: src/Admin/Pages/StatusEditPage.php:572
msgid "The email design (header, footer, colors) follows %s."
msgstr "El diseño del correo electrónico (cabecera, pie de página, colores) sigue %s."

#: src/Admin/Pages/StatusEditPage.php:731
msgid "Check"
msgstr "Marca de verificación"

#: src/Admin/Pages/StatusesPage.php:150
msgid "Status deleted."
msgstr "Estado borrado."

#: src/Admin/Pages/StatusesPage.php:156
msgid "Orders are being moved. The status will be deleted when all orders have been moved."
msgstr "Los pedidos se están moviendo. El estado se borrará cuando se hayan movido todos los pedidos."

#: src/Admin/Pages/StatusesPage.php:162
msgid "The status could not be deleted."
msgstr "El estado no pudo borrarse."

#: src/Automation/Action/AddPrivateNoteAction.php:79
msgid "You can use placeholders such as {order_number}."
msgstr "Puedes usar marcadores de posición como {order_number}."

#: src/Automation/Action/SendAdminEmailAction.php:94
msgid "Comma-separated. The recipient set in WooCommerce > Settings > Emails is always included."
msgstr "Separados por comas. El destinatario establecido en WooCommerce > Ajustes > Correos electrónicos siempre está incluido."

#: src/Automation/Action/SendAdminEmailAction.php:196
#: src/Automation/Action/SendCustomerEmailAction.php:177
msgid "Leave empty to use the default text."
msgstr "Déjalo vacío para usar el texto por defecto."

#: src/Automation/Condition/CustomerRoleCondition.php:39
msgid "Customer role"
msgstr "Perfil del cliente"

#: src/Automation/Condition/CustomerRoleCondition.php:50
msgid "Roles"
msgstr "Perfiles"

#: src/Email/AdminNotificationEmail.php:74
msgid "OrderFlow: admin notification"
msgstr "OrderFlow: aviso al administrador"

#: src/Email/CustomerNotificationEmail.php:73
msgid "OrderFlow: customer notification"
msgstr "OrderFlow: aviso al cliente"

#. translators: %s: status label.
#: src/Status/StatusReassigner.php:201
msgid "Status changed by Webandroll OrderFlow because the status \"%s\" was deleted."
msgstr "Estado modificado por Webandroll OrderFlow porque se borró el estado «%s»."

#. translators: 1: status being deleted, 2: target status.
#: src/Status/StatusReassigner.php:385
msgid "Could not move any order from \"%1$s\" to \"%2$s\". Deletion is blocked."
msgstr "No se ha podido mover ningún pedido de «%1$s» a «%2$s». El borrado está bloqueado."
